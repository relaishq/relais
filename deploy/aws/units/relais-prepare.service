[Unit]
Description=Relais boot credentials
After=network-online.target
Wants=network-online.target
Before=relais-relay.service relais-relay-standby.service relais-worker.service relais-control.service relais-signal.service

[Service]
Type=oneshot
ExecStart=/opt/relais/sdk/bin/python /opt/relais/boot/prepare.py /etc/relais/node.json /run/relais
RemainAfterExit=yes
UMask=0077
StandardOutput=journal
StandardError=journal
