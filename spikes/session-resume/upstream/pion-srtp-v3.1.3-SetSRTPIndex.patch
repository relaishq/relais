+// SRTPIndex returns the SRTP packet index (ROC<<16 | highest sequence number)
+// of specified SSRC, as defined in RFC 3711 Section 3.3.1.
+// ok is false if no packet has been processed for the SSRC yet.
+func (c *Context) SRTPIndex(ssrc uint32) (index uint64, ok bool) {
+	state, exists := c.srtpSSRCStates[ssrc]
+	if !exists || !state.rolloverHasProcessed {
+		return 0, false
+	}
+
+	return state.index, true
 }
 
+// SetSRTPIndex sets the SRTP packet index (ROC<<16 | highest sequence number)
+// of specified SSRC, e.g. to continue a session in a new Context.
+// Unlike SetROC, the rollover counter of the next packet is estimated relative
+// to index, so a sequence number wrap after the index was saved is handled.
+func (c *Context) SetSRTPIndex(ssrc uint32, index uint64) {
+	state, _ := c.getSRTPSSRCState(ssrc, true)
+	state.index = index
+	state.rolloverHasProcessed = true
+}
